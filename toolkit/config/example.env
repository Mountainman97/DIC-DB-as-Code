# -----------------------------------------------------------------------------
# Example environment file for the DIC-DB-as-Code toolkit
# Copy to e.g. config/dev.env in your database repository and adapt.
# Do NOT commit passwords – provide DB_PASSWORD as a pipeline secret or
# environment variable, or use DB_PASSWORD_FILE.
# Priority: command-line option > env file > existing environment variable.
# See docs/03-configuration.md.
# -----------------------------------------------------------------------------

# SQL Server (host, host,port or host\instance)
DB_SERVER="sqlserver-dev.example.local,1433"

# Database (can be overridden with --database)
DB_NAME="DIZ_NET"

# Authentication: sql | integrated (Kerberos, run 'kinit' first)
DB_AUTH="sql"
DB_USER="svc_dacpac"
# DB_PASSWORD="..."                    # better: set as secret / environment variable
# DB_PASSWORD_FILE="/run/secrets/db_password"

# TLS
DB_ENCRYPT="true"
DB_TRUST_SERVER_CERT="true"           # for self-signed certificates
DB_CONNECT_TIMEOUT="30"

# Default publish profile for db-provision-dev.sh / db-diff.sh
PUBLISH_PROFILE="tools/dic-db-as-code/toolkit/config/default.publish.xml"

# Databases that db-provision-dev.sh must never overwrite and that trigger a
# confirmation prompt in the apply scripts (glob patterns allowed)
PROTECTED_DATABASES="DIZ_NET,DIZ_NET_stage"

# History table for db-apply-diff.sh / db-apply-renames.sh (empty = off)
# DEPLOY_HISTORY_TABLE="dbo.__SchemaDeployHistory"

# Optional backup before deployments (none | backup | snapshot), default: none
# BACKUP_MODE="snapshot"
# BACKUP_DIR="/var/opt/mssql/backup"   # path on the SQL SERVER host
# BACKUP_COMPRESSION="true"             # SQL Server Express: false
# BACKUP_KEEP="false"                   # true = keep the backup after success

# Optional tool paths
# SQLPACKAGE_BIN="/opt/sqlpackage/sqlpackage"
# SQLCMD_BIN="/opt/mssql-tools18/bin/sqlcmd"

# Extra arguments passed to every call
# SQLPACKAGE_EXTRA_ARGS="/p:CommandTimeout=300"
# SQLCMD_EXTRA_ARGS=""

# Data versioning: safety limit per table (overridden by max-rows in data.conf)
# DATA_MAX_ROWS="50000"
