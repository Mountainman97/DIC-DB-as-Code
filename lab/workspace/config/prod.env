# DIZPROD – "production" (source of the initial extraction)
DB_SERVER="dizprod,1433"
DB_AUTH="sql"
DB_USER="sa"
DB_PASSWORD="${DIZPROD_SA_PASSWORD:-}"     # provided by the container environment (lab/.env)
DB_TRUST_SERVER_CERT="true"              # self-signed certificate in the container
PUBLISH_PROFILE="/toolkit/config/default.publish.xml"
PROTECTED_DATABASES="DIZ_NET,DIZ_NET_stage"
